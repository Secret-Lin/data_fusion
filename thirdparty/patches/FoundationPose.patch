+  # Exact same sampled points and Euclidean distances, with bounded temporary
+  # memory. The former 10000 x 10000 x 3 array needs several GiB per camera.
+  # Visit the upper block triangle; distance symmetry preserves the maximum.
+  if len(pts) == 0:
+    raise ValueError('Cannot compute the diameter of an empty point set')
+  diameter = 0.0
+  for start in range(0, len(pts), 256):
+    dists = np.linalg.norm(pts[None, start:] - pts[start:start+256, None], axis=-1)
+    diameter = np.maximum(diameter, dists.max())
   return diameter
 
 
